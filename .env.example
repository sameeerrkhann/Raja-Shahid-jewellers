# AI-01 text uses server-only Gemini settings below. Never commit .env.local.
# On this Windows host launch Node with --use-system-ca; never disable TLS verification.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Future server-only integrations remain blank/disabled unless explicitly authorized.
DATABASE_URL=
DATABASE_MIGRATION_URL=
SESSION_TOKEN_PEPPER=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
STORAGE_PUBLIC_BUCKET=
STORAGE_PRIVATE_BUCKET=
OPENAI_API_KEY=
AI_CHAT_PROVIDER=gemini
GEMINI_API_KEY=
# Set true only for a project verified as Free tier, with billing disabled.
GEMINI_FREE_TIER_CONFIRMED=false
AI_CHAT_MODEL=gemini-3.1-flash-lite
# Local application cap, NOT a promise of Google's quota. Each tool round counts.
AI_DAILY_REQUEST_LIMIT=20
AI_VISION_MODEL=
AI_IMAGE_MODEL=
AI_REALTIME_MODEL=
AI_CHAT_ENABLED=false
AI_IMAGE_ENABLED=false
AI_VOICE_ENABLED=false
AI_SITE_DAILY_BUDGET_MINOR=0
AI_SESSION_CHAT_LIMIT=40
AI_SESSION_IMAGE_LIMIT=6
AI_SESSION_VOICE_SECONDS=300
GOLD_RATE_MODE=sample
GOLD_RATE_API_URL=
GOLD_RATE_API_KEY=
GOLD_RATE_REFRESH_SECONDS=
GOLD_RATE_STALE_SECONDS=
WORKER_ENABLED=false
